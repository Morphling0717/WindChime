<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="风铃 WindChime · 安装向导" Width="980" Height="660"
        MinWidth="840" MinHeight="580" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14" Foreground="#263E50" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        KeyboardNavigation.TabNavigation="Cycle">
  <Window.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#263E50" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B8794" />
    <SolidColorBrush x:Key="LineBrush" Color="#55A6BEC9" />
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#649DA7" Offset="0" />
      <GradientStop Color="#367C8B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="0.9,1">
      <GradientStop Color="#EFFFFFFF" Offset="0" />
      <GradientStop Color="#91FFFFFF" Offset="0.5" />
      <GradientStop Color="#D4F8FFFF" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="23" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="#B8FFFFFF" />
      <Setter Property="BorderBrush" Value="#EEFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="19,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="11" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.64" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#376D87" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#6694ACB5" />
      <Setter Property="MinWidth" Value="120" />
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" /></Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollHandle" Background="#6B99B9C4" CornerRadius="3.5" Margin="1,0" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollHandle" Property="Background" Value="#AF7FA5B4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" /></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="#BCFFFFFF" /><Setter Property="BorderBrush" Value="#88C5D7DE" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputSurface" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="#548F9E" /><Setter TargetName="InputSurface" Property="Background" Value="#F0FFFFFF" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputSurface" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#3C596A" /><Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border x:Name="CheckSurface" Width="19" Height="19" CornerRadius="6" Background="#CBFFFFFF"
                      BorderBrush="#91B0BFCA" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="CheckMark" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="White" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,3,0,3" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource AccentBrush}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#56929E" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#285D77" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="9" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4.5" Background="#527B9AA9" />
              <Border x:Name="PART_Indicator" CornerRadius="4.5" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" />
              <Border x:Name="IndeterminateIndicator" CornerRadius="4.5" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1" /></LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#00367C8B" Offset="0.15" />
                    <GradientStop Color="#C5649DA7" Offset="0.4" />
                    <GradientStop Color="#FF367C8B" Offset="0.6" />
                    <GradientStop Color="#00367C8B" Offset="0.85" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="IndeterminateFlow">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="IndeterminateIndicator"
                                       Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                                       From="-1" To="1" Duration="0:0:1.6" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="IndeterminateFlow" /></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StepText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="13,0,0,0" /><Setter Property="Foreground" Value="#78909D" />
    </Style>
    <Style x:Key="StepNumber" TargetType="Border">
      <Setter Property="Width" Value="25" /><Setter Property="Height" Value="25" /><Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#81FFFFFF" /><Setter Property="BorderBrush" Value="#C9FFFFFF" /><Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>

  <Viewbox Stretch="Uniform" Margin="10">
    <Border Width="960" Height="640" CornerRadius="29" BorderThickness="1.5" BorderBrush="#F9FFFFFF">
      <Border.Effect><DropShadowEffect Color="#538391" BlurRadius="16" ShadowDepth="4" Opacity="0.17" /></Border.Effect>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F1F8FD" Offset="0" /><GradientStop Color="#E5F2F4" Offset="0.53" /><GradientStop Color="#E9EFFA" Offset="1" /></LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid IsHitTestVisible="False" ClipToBounds="True" Margin="1">
          <Ellipse Width="415" Height="370" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-76,-15,0">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#AEBADAFE" Offset="0" /><GradientStop Color="#00BADAFE" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
          </Ellipse>
          <Ellipse Width="480" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-88">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#AAAFE8D8" Offset="0" /><GradientStop Color="#00AFE8D8" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
          </Ellipse>
          <Ellipse Width="298" Height="298" Stroke="#72FFFFFF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-50,27,0" />
          <Ellipse Width="328" Height="328" Stroke="#48FFFFFF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-65,12,0" />
          <Path Data="M -12,520 C 120,418 210,704 420,583" Stroke="#B4FFFFFF" StrokeThickness="1.3" />
        </Grid>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="55" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid x:Name="TitleBar" Background="Transparent" Margin="29,8,17,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Border CornerRadius="10" BorderBrush="#DFFFFFFF" BorderThickness="1" Background="#8CFFFFFF" Padding="10,4" Margin="0,0,17,0">
                <TextBlock Text="Windows" FontFamily="Segoe UI" FontSize="10" Foreground="#6A8997" />
              </Border>
              <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" AutomationProperties.Name="最小化" ToolTip="最小化" TabIndex="90">
                <Path Data="M 0,4 L 10,4" Width="10" Height="8" Stroke="#6B8594" StrokeThickness="1.3" />
              </Button>
              <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" AutomationProperties.Name="关闭安装向导" ToolTip="关闭" TabIndex="91">
                <Path Data="M 0,0 L 9,9 M 0,9 L 9,0" Width="10" Height="10" Stroke="#6B8594" StrokeThickness="1.3" />
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border CornerRadius="23" Background="#72FFFFFF" BorderBrush="#E9FFFFFF" BorderThickness="1" Padding="22,19,22,20">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="200" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Image x:Name="BrandImage" Width="183" Height="169" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="风铃 WindChime" />
                <StackPanel Grid.Row="1" Margin="8,18,0,0">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                    <Border x:Name="Step1Dot" Style="{StaticResource StepNumber}" Background="{StaticResource AccentBrush}" BorderBrush="#93C9D5"><TextBlock x:Name="Step1Number" Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11" /></Border>
                    <TextBlock x:Name="Step1Text" Text="安装风铃" Style="{StaticResource StepText}" Foreground="#356477" FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                    <Border x:Name="Step2Dot" Style="{StaticResource StepNumber}"><TextBlock x:Name="Step2Number" Text="2" Foreground="#77909D" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11" /></Border>
                    <TextBlock x:Name="Step2Text" Text="开源许可" Style="{StaticResource StepText}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                    <Border x:Name="Step3Dot" Style="{StaticResource StepNumber}"><TextBlock x:Name="Step3Number" Text="3" Foreground="#77909D" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11" /></Border>
                    <TextBlock x:Name="Step3Text" Text="安装选项" Style="{StaticResource StepText}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                    <Border x:Name="Step4Dot" Style="{StaticResource StepNumber}"><TextBlock x:Name="Step4Number" Text="4" Foreground="#77909D" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11" /></Border>
                    <TextBlock x:Name="Step4Text" Text="正在安装" Style="{StaticResource StepText}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border x:Name="Step5Dot" Style="{StaticResource StepNumber}"><TextBlock x:Name="Step5Number" Text="5" Foreground="#77909D" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="11" /></Border>
                    <TextBlock x:Name="Step5Text" Text="安装完成" Style="{StaticResource StepText}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="23" Background="{StaticResource GlassBrush}" BorderBrush="#F9FFFFFF" BorderThickness="1" Padding="29,27,29,22">
              <Border.Effect><DropShadowEffect Color="#5B8796" BlurRadius="24" ShadowDepth="8" Opacity="0.06" /></Border.Effect>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock x:Name="PageHeading" Text="安装风铃" FontSize="25" FontWeight="SemiBold" Foreground="#2A4558" />
                  <TextBlock x:Name="PageDescription" Text="仅为当前 Windows 用户安装。" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,16">
                  <Grid x:Name="WelcomePage" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" Margin="1,0,1,24">
                      <TextBlock Text="安装前请退出风铃" FontSize="20" FontWeight="Medium" Foreground="#2D4E64" />
                      <TextBlock Text="请保存正在编辑的内容，并从托盘菜单选择“退出并结束展示”。" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
                      <TextBlock Text="接下来可以选择安装位置和快捷方式。" Style="{StaticResource BodyText}" Margin="0,24,0,0" />
                    </StackPanel>
                  </Grid>

                  <Grid x:Name="LicensePage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border CornerRadius="9" Background="#63D8EEE8" Padding="11,8" Margin="0,0,0,12"><TextBlock Text="MIT License" FontSize="12" Foreground="#4E7F7B" /></Border>
                    <TextBox x:Name="LicenseBody" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas"
                             FontSize="12.5" Padding="15,13" VerticalContentAlignment="Top" AutomationProperties.Name="MIT 许可证原文" TabIndex="0" />
                    <TextBlock Grid.Row="2" Text="分发时请保留版权与许可声明。第三方组件沿用各自许可证。" Style="{StaticResource BodyText}" FontSize="11" Margin="0,11,0,0" />
                  </Grid>

                  <Grid x:Name="OptionsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0" Focusable="False">
                      <StackPanel>
                        <TextBlock Text="安装位置" FontSize="13" FontWeight="Medium" Foreground="#446271" />
                        <TextBlock Text="仅为当前 Windows 用户安装" Style="{StaticResource BodyText}" FontSize="11" Margin="0,3,0,8" />
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
                          <TextBox x:Name="PathBox" Height="44" Padding="10,3" AutomationProperties.Name="安装位置" TabIndex="0" />
                          <Button x:Name="BrowseButton" Grid.Column="2" Content="浏览…" Padding="10,9" AutomationProperties.Name="选择安装文件夹" TabIndex="1" />
                        </Grid>
                        <TextBlock Text="更新会保留已有连接和个人设置。" Style="{StaticResource BodyText}" FontSize="11" Margin="0,8,0,17" />
                        <TextBlock Text="快捷方式" FontSize="13" FontWeight="Medium" Foreground="#446271" Margin="0,0,0,12" />
                        <CheckBox x:Name="DesktopCheck" Content="在桌面创建快捷方式" IsChecked="True" Margin="0,0,0,10" TabIndex="2" />
                        <CheckBox x:Name="MenuCheck" Content="添加到开始菜单" IsChecked="True" TabIndex="3" />
                        <Border x:Name="LegacyNotice" Visibility="Collapsed" CornerRadius="12" Background="#8EF1F4DF" BorderBrush="#5BC4CAA4" BorderThickness="1" Padding="13,10" Margin="0,19,0,0">
                          <TextBlock Text="检测到旧版。新版将独立安装并沿用连接设置，旧版不会自动卸载。快捷方式名为“风铃 WindChime”。" FontSize="11" TextWrapping="Wrap" LineHeight="20" Foreground="#718063" />
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>

                  <Grid x:Name="ProgressPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="2,0,2,24">
                      <Grid Width="90" Height="90" HorizontalAlignment="Left" Margin="0,0,0,26">
                        <Ellipse Fill="#74E8F5F5" Stroke="#CBFFFFFF" StrokeThickness="1" />
                        <Ellipse Width="67" Height="67" Stroke="#769BBCC9" StrokeThickness="1" />
                        <Path Data="M 45,25 L 45,54 M 34,43 L 45,54 L 56,43 M 29,62 L 61,62" Stroke="#6296A3" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Grid>
                      <Grid Margin="0,0,0,12">
                        <TextBlock x:Name="ProgressCaption" Text="正在准备安装…" FontSize="15" Foreground="#446A7C" Margin="0,0,65,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="ProgressPercent" Text="{Binding ElementName=ProgressBar, Path=Value, StringFormat={}{0:0}%}" FontFamily="Segoe UI" FontSize="15" Foreground="#6595A3" HorizontalAlignment="Right" />
                      </Grid>
                      <ProgressBar x:Name="ProgressBar" Value="0" AutomationProperties.Name="安装进度" />
                      <TextBlock Text="已有连接和个人设置会保留。" Style="{StaticResource BodyText}" Margin="0,20,0,0" />
                    </StackPanel>
                  </Grid>

                  <Grid x:Name="FinishPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,0,15">
                      <Border Width="71" Height="71" CornerRadius="24" Background="#ADD9EDE5" BorderBrush="#EFFFFFFF" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <Path Data="M 21,35 L 31,45 L 51,24" Stroke="#559885" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      </Border>
                      <Border CornerRadius="10" Background="#A2FFFFFF" BorderBrush="#DFFFFFFF" BorderThickness="1" Padding="12,10">
                        <StackPanel><TextBlock Text="安装位置" FontSize="10" Foreground="#8198A4" /><TextBlock x:Name="FinishPath" TextWrapping="Wrap" FontSize="12" Foreground="#5A7887" Margin="0,5,0,0" /></StackPanel>
                      </Border>
                      <CheckBox x:Name="RunAfterFinishCheck" Content="完成后启动风铃" IsChecked="False" Margin="0,20,0,0" TabIndex="0" />
                    </StackPanel>
                  </Grid>
                </Grid>

                <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#A65F58" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
                <Grid Grid.Row="3">
                  <Border BorderBrush="#3EA6C1CB" BorderThickness="0,1,0,0" Margin="0,0,0,0" />
                  <Grid Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="取消" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="3,10" Foreground="#7F96A3" TabIndex="12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button x:Name="BackButton" Content="上一步" Visibility="Collapsed" Margin="0,0,10,0" MinWidth="88" TabIndex="10" />
                      <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}" IsDefault="True" TabIndex="11" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Viewbox>
</Window>
