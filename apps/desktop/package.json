{
  "name": "windchime-desktop",
  "productName": "WindChime",
  "version": "0.8.1",
  "description": "风铃直播信箱 · 私人审核与播出控制台",
  "author": "WindChime contributors",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm start",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package --platform=win32 --arch=x64",
    "make": "npm run build && node scripts/make.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:smoke": "npm run build && electron scripts/smoke.cjs",
    "test:sites": "npm run build && node scripts/run-site-smoke.cjs",
    "test:keys": "npm run build && node scripts/run-key-smoke.cjs",
    "test:visual": "npm run test:management",
    "test:tiles": "npm run build && node scripts/run-tiles-smoke.cjs",
    "test:management": "npm run build && node scripts/run-management-smoke.cjs"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "homepage": "https://github.com/Morphling0717/WindChime"
}
