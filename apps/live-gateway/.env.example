# Public HTTPS origin; localhost HTTP is only allowed when NODE_ENV is not production.
GATEWAY_ORIGIN=http://localhost:3390
PORT=3390
HOST=127.0.0.1
DATA_DIR=./data
# Server only. Leave blank until the correct live creator platform project is configured.
# Copy this file to .env. Keep the variable names and replace only the values after =.
# Platform labels access_key_id / access_key_secret map to the next two variables.
BILIBILI_ACCESS_KEY_ID=
BILIBILI_ACCESS_KEY_SECRET=
# Explicitly confirm this key in the H5 project configuration; no implicit key substitution.
BILIBILI_H5_SIGN_SECRET=
BILIBILI_H5_APP_ID=
BILIBILI_DESKTOP_APP_ID=
# Do not enable HTTP outside local development.
NODE_ENV=development
